    "prettier": "^2.7.1",
    "typescript": "^4.8.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "git add ."
    ],
    "src/**/*.{html,css,less,ejs,json}": [
      "prettier --write",
      "git add ."
    ],
    "*.js": "eslint --cache --fix"
  }
